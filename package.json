{
  "name": "suregrad",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:api": "pnpm --filter @suregrad/api start:dev",
    "build:admin": "pnpm --dir apps/admin build",
    "build:api": "pnpm --filter @suregrad/api build",
    "lint:admin": "pnpm --dir apps/admin lint",
    "lint:api": "pnpm --filter @suregrad/api lint",
    "test:api": "pnpm --filter @suregrad/api test",
    "test:api:e2e": "pnpm --filter @suregrad/api test:e2e",
    "analyze:mobile": "cd apps/mobile && flutter analyze",
    "test:mobile": "cd apps/mobile && flutter test",
    "verify:api": "pnpm build:api && pnpm lint:api && pnpm --filter @suregrad/api test -- --runInBand",
    "verify:admin": "pnpm build:admin && pnpm lint:admin",
    "verify:mobile": "pnpm analyze:mobile && pnpm test:mobile",
    "verify:visual": "npm install --prefix tools/visual-qa && node tools/visual-qa/capture-admin.mjs && node tools/visual-qa/run-mobile-visual.mjs",
    "verify": "pnpm verify:api && pnpm verify:admin && pnpm verify:mobile",
    "verify:all": "pnpm verify && pnpm verify:visual",
    "db:schema": "python tools/data-import/apply_schema.py",
    "db:migrate": "python tools/data-import/apply_migrations.py",
    "db:import:ecust": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-ecust-cs-2024.yaml --report-dir tools/data-import/.out/reports/ecust-cs-2024",
    "db:import:sufe": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-sufe-finance-2024.yaml --report-dir tools/data-import/.out/reports/sufe-finance-2024",
    "db:import:zju": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-zju-cs-2024.yaml --report-dir tools/data-import/.out/reports/zju-cs-2024",
    "db:import:fudan": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-fudan-finance-2024.yaml --report-dir tools/data-import/.out/reports/fudan-finance-2024",
    "db:import:nju": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-nju-se-2024.yaml --report-dir tools/data-import/.out/reports/nju-se-2024",
    "db:import:moe-universities": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-moe-universities-2025.yaml --report-dir tools/data-import/.out/reports/moe-universities-2025",
    "db:import:official-school-websites": "python tools/data-import/import_to_db.py --config tools/data-import/config.import-official-school-websites-2026-06-07.yaml --report-dir tools/data-import/.out/reports/official-school-websites-2026-06-07",
    "db:seed:ecust": "pnpm db:migrate && pnpm db:import:ecust",
    "db:seed:collected": "pnpm db:migrate && pnpm db:import:moe-universities && pnpm db:import:official-school-websites && pnpm db:import:ecust && pnpm db:import:sufe && pnpm db:import:zju && pnpm db:import:fudan && pnpm db:import:nju",
    "db:seed:resources": "python tools/data-import/seed_study_resources.py",
    "db:seed:admin": "python tools/data-import/seed_admin_users.py",
    "db:seed:demo": "pnpm db:seed:collected && pnpm db:seed:resources && pnpm db:seed:admin"
  }
}
